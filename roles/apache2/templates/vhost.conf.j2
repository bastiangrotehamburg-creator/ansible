# {{ ansible_managed }}
{% set cert_dir = '/etc/letsencrypt/live/' ~ item.server_name %}
{% set use_ssl = item.letsencrypt | default(false) and item.server_name in apache2_existing_certs %}
<VirtualHost *:80>
    ServerName {{ item.server_name }}
{% for alias in item.server_aliases | default([]) %}
    ServerAlias {{ alias }}
{% endfor %}
{% if use_ssl %}
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
{% else %}
    DocumentRoot {{ item.document_root }}

    <Directory {{ item.document_root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride {{ item.allow_override | default('None') }}
        Require all granted
    </Directory>
{% endif %}

    ErrorLog ${APACHE_LOG_DIR}/{{ item.name }}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ item.name }}_access.log combined
</VirtualHost>
{% if use_ssl %}

<VirtualHost *:443>
    ServerName {{ item.server_name }}
{% for alias in item.server_aliases | default([]) %}
    ServerAlias {{ alias }}
{% endfor %}
    DocumentRoot {{ item.document_root }}

    SSLEngine on
    SSLCertificateFile {{ cert_dir }}/fullchain.pem
    SSLCertificateKeyFile {{ cert_dir }}/privkey.pem
{% if apache2_hsts | bool %}
    Header always set Strict-Transport-Security "max-age={{ apache2_hsts_max_age }}"
{% endif %}

    <Directory {{ item.document_root }}>
        Options -Indexes +FollowSymLinks
        AllowOverride {{ item.allow_override | default('None') }}
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/{{ item.name }}_ssl_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ item.name }}_ssl_access.log combined
</VirtualHost>
{% endif %}
